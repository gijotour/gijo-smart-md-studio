{
  "name": "gijo-smart-md-studio",
  "version": "2.1.0",
  "description": "GIJO Smart MD Studio - 이미지가 들어가는 마크다운(MD) 전용 문서 작성기",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "keywords": [
    "markdown",
    "editor",
    "word",
    "base64",
    "images"
  ],
  "author": "GIJO",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.gijo.smartmdstudio",
    "productName": "GIJO Smart MD Studio",
    "icon": "build/icon.png",
    "artifactName": "GIJO-Smart-MD-Studio-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "assets/**/*",
      "css/**/*",
      "js/**/*",
      "vendor/**/*",
      "!vendor/VERSIONS.md"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gijotour",
        "repo": "gijo-smart-md-studio"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
